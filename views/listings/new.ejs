<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WanderHub</title>
  </head>
  <body>
    <h3>Create a new List</h3>
    <div>
      <form method="POST" action="/listings">
      <label for="title" class="form-label">Title</label>
      <input
        name="listing[title]"
        placeholder="enter title"
        type="text"
        class="form-control"
      />
    </div>
      <div>
        <label for="description" class="form-label">Description</label>
<textarea
        name="listing[description]"
        class="form-label"
        type="text"
      ></textarea>
      </div>
    <div>
      <label for="image" class="form-label">Image</label>
      <input name="listing[image]" placeholder="enter image URL" type="text" class="form-label"/>
    </div>
      <div>
        <label for="price" class="form-label">Price</label>
      <input name="listing[price]" placeholder="enter price" type="number" class="form-label"/>
      </div>
      <div>
        <label for="location" class="form-label">Location</label>
<input
        name="listing[location]"
        placeholder="enter location"
        type="text"
        class="form-label"
      />
      </div>
      <div>
        <label for="country" class="form-label">Country</label>
      <input name="listing[country]" placeholder="enter country" type="text" class="form-label" />
      </div>
      <button class="btn btn-dark">Add</button>
    </form>
  </body>
</html>
